# Cloudflare Pages — 本仓库推荐构建设置
#
# 在 Cloudflare Dashboard → Workers & Pages → Create → Connect to Git 时填写：
#
#   Build command:          npm run docs:build
#   Build output directory: docs/.vitepress/dist
#   Root directory:         /
#   Node version:           22（环境变量 NODE_VERSION=22）
#
# 部署成功后地址形如：https://<project-name>.pages.dev

NODE_VERSION=22
